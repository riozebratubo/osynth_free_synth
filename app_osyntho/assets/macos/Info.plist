<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Keep CFBundleIdentifier in sync with APP_ID in CMakeLists.txt: it is
         also the single-instance lock name, and deploy_macos_multi.sh checks
         the built bundle against it. -->
    <key>CFBundleIdentifier</key>
    <string>org.osynth.osyntho</string>
    <key>CFBundleName</key>
    <string>Osyntho</string>
    <key>CFBundleDisplayName</key>
    <string>Osyntho</string>
    <key>CFBundleShortVersionString</key>
    <string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
    <key>CFBundleVersion</key>
    <string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleExecutable</key>
    <string>@MACOSX_BUNDLE_EXECUTABLE_NAME@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Required for CoreBluetooth: without a usage string macOS terminates the
         process the first time QBluetoothDeviceDiscoveryAgent starts a scan.
         No location keys here — unlike iOS/Android, macOS does not gate BLE
         scanning behind location permission. No camera/photo keys either: the
         only QtMultimedia user (src/camerapreviewitem.cpp) is not in the build. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Osyntho uses Bluetooth to connect to your Osynth synthesizer.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Osyntho uses Bluetooth to connect to your Osynth synthesizer.</string>
    <!-- Matches CMAKE_OSX_DEPLOYMENT_TARGET in CMakeLists.txt. Declaring an
         older floor here than the toolchain built for lets the app launch on
         systems where it then dies on a missing symbol. -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
</dict>
</plist>
