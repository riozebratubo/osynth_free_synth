<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Substituted by CMake from the target's MACOSX_BUNDLE_GUI_IDENTIFIER /
         MACOSX_BUNDLE_BUNDLE_NAME, i.e. APP_ID and APP_DISPLAY_NAME:
         org.osynth.osyntho / "Osyntho" for the controller build,
         org.osynth.osyntho.standalone / "Osyntho Standalone" for the embedded
         one. iOS keys an installed app off the bundle id alone, so a fixed
         value here is what would stop the two being installed together.

         These three read "org.poproaster.caramel" / "Caramel 2" until
         2026-09: this file started as a copy from another project. The
         NS*UsageDescription strings below still carry that project's wording
         and need rewriting for Osyntho before any iOS submission. -->
    <key>CFBundleIdentifier</key>
    <string>@MACOSX_BUNDLE_GUI_IDENTIFIER@</string>
    <key>CFBundleName</key>
    <string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
    <key>CFBundleDisplayName</key>
    <string>@MACOSX_BUNDLE_BUNDLE_NAME@</string>
    <key>CFBundleShortVersionString</key>
    <string>@MACOSX_BUNDLE_SHORT_VERSION_STRING@</string>
    <key>CFBundleVersion</key>
    <string>@MACOSX_BUNDLE_BUNDLE_VERSION@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleExecutable</key>
    <string>@MACOSX_BUNDLE_EXECUTABLE_NAME@</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Caramel 2 needs Bluetooth to connect to your roaster device.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Caramel 2 uses location to scan for nearby Bluetooth roaster devices.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Caramel 2 uses location to scan for nearby Bluetooth roaster devices.</string>
    <!-- Required, not optional: App::startEmbeddedEngine() requests the
         microphone permission on the standalone build, and iOS terminates a
         process that requests a permission with no usage string here. Written
         for Osyntho, unlike the strings around it. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Osyntho uses the audio input as a sound source: the line input, the vocoder and the granular engine all read from it.</string>
    <key>NSCameraUsageDescription</key>
    <string>Caramel 2 uses the camera to take pictures of your roast.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Caramel 2 saves roast pictures to your photo library.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Caramel 2 saves roast pictures to your photo library.</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>bluetooth-le</string>
        <!-- "armv7" removed 2026-07: obsolete on arm64-only iOS (Apple advises
             against declaring it for modern apps). Restore only if the app ever
             needs to state a 32-bit requirement, which it should not. -->
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>MinimumOSVersion</key>
    <string>16.0</string>
</dict>
</plist>
