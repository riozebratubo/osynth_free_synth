# osynth — shared defaults for all targets.
# Target-specific overrides live in sdkconfig.defaults.esp32 / sdkconfig.defaults.esp32s3
# (ESP-IDF picks those up automatically after this file).

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# -O2: the DSP code needs it
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Max CPU clock lives in the per-target files: the choice members are named
# after the frequency and the targets do not share one (240 MHz on the Xtensa
# chips; on the P4 it depends on the chip revision — 360 MHz below rev 3.0,
# 400 MHz at and above it, see sdkconfig.defaults.esp32p4), so a line here
# would be an unknown symbol on whichever target it did not fit. The reason
# for wanting the top of the range is the same everywhere — ~27%
# idle FX load + ~12% per subtractive voice at 160 MHz meant full polyphony
# overran the 1.33 ms block deadline, audible as noise bursts.

# 1 kHz tick for fine-grained delays in control tasks
CONFIG_FREERTOS_HZ=1000

# Bluetooth (NimBLE) — used by ble_ctrl (Session 14). Enabled from day one so the
# flash/RAM budget stays realistic throughout development.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# ble_ctrl is a single-connection peripheral: drop the central/observer roles
# and the spare connection slots to save RAM (matters on the classic ESP32,
# which also carries the FX buffers in internal RAM).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# NimBLE logs two INFO lines for every notification. The synth sends events at
# ~20 Hz and floods during parameter discovery, so at INFO the host task spends
# a large part of its time in blocking UART writes — and it is the task that
# has to find an mbuf for the next notification, so the chatter costs
# reliability, not just readability. It also buries the firmware's own logs.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Host buffer pool (msys). IDF's defaults are 12x256 B and 24x320 B, which were
# sized for small ATT payloads — but BT_NIMBLE_ATT_PREFERRED_MTU defaults to
# 256, and a 253-byte ATT payload plus the os_mbuf and packet headers does not
# fit a 256-byte block, so every full-size frame this protocol sends comes out
# of the 24 msys-2 blocks. A connect burst is several multi-frame listings back
# to back and drained that pool, at which point NimBLE could not allocate for
# the *receive* path either: "E NimBLE: ble_att_svr_pkt rc=6" (BLE_HS_ENOMEM),
# an incoming ATT request left unanswered because even the error response
# needs a buffer, and — ATT allowing one outstanding request per bearer — the
# central closing the link on the 30 s transaction timeout (reason 0x213,
# measured at 30078 ms from the rc=6, twice).
#
# The pacing in ble_ctrl's Chunker is the actual fix for that; this is the
# headroom underneath it, so a burst waits a few milliseconds rather than
# spending its whole budget in send_frame_paced. ~11 kB of internal RAM: free
# on the P4/S3, and the one place to trim first if the classic ESP32 gets
# tight.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=48

# Room for the param-registry dump and init logging in app_main
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# experiment — NOTE: the symbol is OSYNTH_BLOCK_SIZE (see
# components/synth_core/Kconfig.projbuild). It was written as
# CONFIG_AUDIO_BLOCK_SIZE, which is not a real symbol, so IDF silently
# ignored it and the S21b measurements were taken at the default 64.
# The per-stage meter since showed load is not the problem (peak 71% of
# budget at 8 voices), so this is optional — drop it back to 64 if you
# prefer the lower latency.
CONFIG_OSYNTH_BLOCK_SIZE=64

# Period of the "alive | ..." status line, 0 silences it. Also a diagnostic:
# it is the only periodic event in the firmware slower than 500 ms, so if you
# hear a click at this period, change it to 30000 and listen — if the clicks
# follow, the logging path is the cause and not the synthesis.
CONFIG_OSYNTH_HEARTBEAT_MS=5000

# ===========================================================================
# "osynth Synthesizer" menu — the rest of it, target-independent options.
#
# Everything below is commented out *at its Kconfig default*
# (components/synth_core/Kconfig.projbuild), so uncommenting a line without
# editing its value changes nothing — the value shown is what you already
# get. Uncomment and edit to override, or pin a default you want to survive
# a Kconfig change.
#
# Syntax: bools take =y or =n; an int takes the number; a choice is set by
# giving exactly one of its member symbols =y (never =n — that just leaves
# the choice at its own default).
#
# Options whose default or availability depends on the chip (I2S front end
# and its pins, PSRAM-backed features, USB) live in sdkconfig.defaults.esp32
# and sdkconfig.defaults.esp32s3, which ESP-IDF applies after this file.
# ===========================================================================

# --- Control surfaces -------------------------------------------------------

# BLE control for the companion mobile app: custom GATT service, binary TLV
# protocol (private_docs/BLE_PROTOCOL.md). Default y.
# Note that =n only compiles out ble_ctrl; the NimBLE stack is still built,
# because CONFIG_BT_ENABLED above is independent. Set that to n as well to
# actually reclaim the flash and RAM.
# CONFIG_OSYNTH_ENABLE_BLE=y

# Local UI (LCD + encoders + buttons). Default n — the component compiles to
# a stub, and the synth is driven over BLE/USB-MIDI instead.
# CONFIG_OSYNTH_ENABLE_LOCAL_UI=n

# Serial (UART/DIN) MIDI input on UART1 at 31250 baud. Default n. Mainly for
# the classic ESP32, which has no USB-OTG and so no USB-MIDI. Needs a proper
# optocoupled input circuit (6N138) — never wire a DIN cable straight to the
# GPIO. The RX pin default differs per target, so OSYNTH_SERIAL_MIDI_RX_GPIO
# is listed in the two target files.
# CONFIG_OSYNTH_ENABLE_SERIAL_MIDI=n

# --- Engine sizing ----------------------------------------------------------

# Polyphony. Range 1..16, default 8. Costs render budget roughly linearly
# (~12% of the block deadline per subtractive voice at 160 MHz, which is why
# 240 MHz is forced above); the heartbeat's load figure is the thing to watch
# after raising it — peak was 71% of budget at 8 voices.
# CONFIG_OSYNTH_VOICES=8

# Sample rate. Default 48000, which is what the UAC2 descriptor advertises —
# usb_descriptors.h builds itself from this symbol, so USB audio follows a
# change automatically, as does the I2S MCLK (256x fs). 48000 is the tested
# value; anything else is untested against the host class drivers.
# CONFIG_OSYNTH_SAMPLE_RATE=48000

# Modular patch graph engine (S28): a fifth engine whose signal path is a node
# graph patched with cables instead of a fixed chain. Costs an audio buffer
# pool in internal RAM (~12 KB at the defaults) plus its kernels in IRAM.
# Default y on the ESP32-S3, n on the classic ESP32 — there the fixed engines
# fuse and a freely patched graph does not, and the headroom left after the FX
# bus does not reliably fit one. Uncommenting here applies to both targets.
# CONFIG_OSYNTH_ENABLE_MODULAR=y

# --- Sample kits (S44) ------------------------------------------------------

# Recordable kits alongside the factory one. Each has 16 pads that can be
# sampled from the audio input or from the synth's own output; all of them are
# resident, so a pad can be recorded without first selecting its kit. Default 8
# on any PSRAM board, 0 without (there is nowhere for the audio to live).
# An empty kit costs only its ~3 KB slot table.
# CONFIG_OSYNTH_SAMPLE_KITS=8

# The PSRAM every recorded pad across every kit shares, plus whatever is read
# back from storage at boot. Mono 16-bit at the render rate, so 4 MB is about
# 43 seconds in total across 128 pads.
#
# This comes out of the same pool the looper sizes itself from, and drums_init()
# runs first, so raising it shortens the advertised loop time rather than
# failing later — on the 32 MB P4 board, 4 MB costs the looper roughly ten
# seconds of its 160 s base cap. The boot log prints both.
# CONFIG_OSYNTH_SAMPLE_POOL_KB=4096

# Longest single take, and so the staging buffer's size: 768 KB at 8 s, claimed
# on the first time a pad is armed and never given back. 8 s is a little over
# four bars at 120 BPM, which is what makes the slicer worth having.
# CONFIG_OSYNTH_SAMPLE_MAX_SEC=8

# Kits recorded on the synth persist to /sd/osynth/kits/kitN as plain WAVs plus
# a small sidecar, falling back to the LittleFS `storage` partition when there
# is no card (about ten seconds in total, shared with the presets). This
# separate option adds the *other* direction — loading `<name>.okit` images and
# hand-made WAV folders that tools/gen_drumkit.py or a desktop produced.
# Default n.
# CONFIG_OSYNTH_DRUM_SD_KITS=n

# --- Render path ------------------------------------------------------------

# Marks the per-block render path (engines, voice manager, FX bus, looper,
# audio-task conversion) IRAM_ATTR, so flash-cache misses from BLE/Wi-Fi or
# filesystem traffic cannot add jitter to the audio deadline. Default y, costs
# ~20-30 KB of IRAM. Set n if the image stops linking with "region iram0
# overflowed".
# CONFIG_OSYNTH_RENDER_IN_IRAM=y
