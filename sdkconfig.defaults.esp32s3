# ESP32-S3 target overrides — assumes an N8R8-class board (8 MB flash, 8 MB octal PSRAM).
# For quad-PSRAM boards (R2 variants) switch CONFIG_SPIRAM_MODE_OCT to CONFIG_SPIRAM_MODE_QUAD;
# see docs/HARDWARE.md. SPIRAM_IGNORE_NOTFOUND keeps boards without (working) PSRAM booting.
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_OSYNTH_FLASH_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Max CPU clock (IDF defaults to 160 MHz): the render budget needs it — see
# the note in sdkconfig.defaults.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 32 KB instruction cache (default 16 KB, costs 16 KB internal RAM): the
# render chain runs from flash and the engine code path is cold at note-on,
# so the small i-cache showed up as underrun spikes on note onsets.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Loop-persistence flash backend (S16): auto-suspend would let cache fetches
# suspend an in-progress flash erase/program so a multi-MB loop save doesn't
# starve the render chain. DO NOT enable it here: on ESP-IDF v6.0.1 a chip
# whose suspend support isn't in the IDF allow-list (e.g. the Boya modules on
# these boards) fails esp_flash_init() and the assert at esp_flash_spi_init.c
# hard-faults into a bootloop (S17 regression). The looper transport is stopped
# while saving in code regardless, so suspend only ever softened residual
# stalls — not worth bricking boot. Re-enable only per-board once the chip is
# confirmed on IDF's suspend-supported list.
# CONFIG_SPI_FLASH_AUTO_SUSPEND is not set

# External I2S DAC (PCM5102A) is the master out
CONFIG_OSYNTH_ENABLE_I2S_DAC=y

# ===========================================================================
# "osynth Synthesizer" options that are target-specific on the ESP32-S3.
# Commented out at their Kconfig default; see the header in sdkconfig.defaults
# for the syntax and for the target-independent options.
#
# Already set above and deliberately left alone: OSYNTH_ENABLE_I2S_DAC (the
# DAC is the master out on this target) and OSYNTH_FLASH_16MB (the module
# size the flash loops region is cut from — the other choice member is
# CONFIG_OSYNTH_FLASH_8MB=y for an 8 MB module, which also wants
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y so the image header matches the chip).
# ===========================================================================

# --- I2S analogue front end -------------------------------------------------

# What is on the other end of the I2S port. This picks the *analogue*
# hardware; the digital side is identical either way. Exactly one member,
# default DISCRETE:
#
#   DISCRETE  PCM5102A DAC (+ optional PCM1808 ADC). Each chip is strapped by
#             pins and needs no firmware. Best sounding — ~112 dB against the
#             ES8388's ~96 — and the one to pick if the line output is what
#             the instrument is judged on. Line input costs a second chip and
#             two more GPIOs.
#   ES8388    One codec for both directions, as on the ESP32-A1S, LyraT and
#             most "ESP32 audio kit" boards. A step below a discrete DAC, but
#             it is what is already soldered to those boards, and it brings
#             an ADC, mic preamp and headphone driver. It has no useful
#             strapping pins: it stays silent until the firmware writes its
#             registers over I2C (OSYNTH_ES8388_I2C_* below), and it needs
#             MCLK, so selecting it puts the port into the 32-bit-slot /
#             64x fs / MCLK arrangement whether or not capture is on.
#
# CONFIG_OSYNTH_FRONTEND_DISCRETE=y
CONFIG_OSYNTH_FRONTEND_ES8388=y

# Stereo line input — I2S capture on the DAC's own port, so the converter
# runs as a slave off BCLK/WS and capture is sample-locked to playback by
# construction: nothing drifts and nothing is resampled. Default n on a
# discrete front end (it needs a PCM1808 and two more pins), y on ES8388
# (the ADC is already in the chip). Costs ~0.7% of the block budget and 256
# bytes; monitoring latency is one DMA buffer plus a block, ~8-9 ms.
# Placement in the render chain is a runtime param (`in.route`: off/mon/fx/
# dry), not a build option — private_docs/HARDWARE.md.
# CONFIG_OSYNTH_ENABLE_I2S_LINE_IN=n

# Stream to USB *and* the I2S DAC at once, instead of the DAC replacing the
# USB output. Default y. The DAC keeps the clock — its DMA still paces the
# render loop and the USB write is best-effort, so a stalled host cannot
# stall the audio task. Costs a 256-byte copy per block plus the EP-IN FIFO.
# =n restores the older either/or behaviour, where the USB audio interface
# stays enumerated but silent.
# CONFIG_OSYNTH_USB_AUDIO_TAP=y

# --- I2S pins ---------------------------------------------------------------

# All five are configurable because codec boards come with their pinout
# already soldered. Defaults sit in one block at 14-18; GPIO19/20 are the
# native USB pins and **GPIO33-37 are the octal PSRAM — never touch those**.
# Avoid strapping pins GPIO0, 3, 45, 46.
CONFIG_OSYNTH_I2S_BCLK_GPIO=16
CONFIG_OSYNTH_I2S_WS_GPIO=17
# DOUT: PCM5102A DIN, or ES8388 DSDIN.
CONFIG_OSYNTH_I2S_DOUT_GPIO=18
# DIN: PCM1808 DOUT, or ES8388 ASDOUT. Only with line input on.
CONFIG_OSYNTH_I2S_DIN_GPIO=15
# MCLK: converter system clock at 256x fs (12.288 MHz at 48 kHz) — PCM1808
# SCKI or ES8388 MCLK. Mandatory for both even in slave mode; without it a
# PCM1808 reads silence while the starve counter climbs and an ES8388 does
# not play at all. Only with line input or the ES8388 front end.
CONFIG_OSYNTH_I2S_MCLK_GPIO=14

# --- Microphone input (S37) -------------------------------------------------

# A second input device: a digital MEMS mic (INMP441 / ICS-43434 / SPH0645) on
# the **second** I2S controller. Off by default, and a build with it off is
# byte-for-byte the input path that shipped before it existed.
#
# Why a second controller and not a second DIN pin on the port above: a port
# has one RX channel and one DIN, and the line input has them. The S3 has two
# controllers, so the second is free.
#
# `in.source` (line / mic) picks which device feeds the one input chain — the
# same `in.route`, the same `in.gain`, the same meters. It is only registered
# on a build that has both, and it is persisted, so the box comes back on the
# input it was left on. Switching is fenced: the route gains ramp to zero, the
# source swaps at silence, the gains ramp back, so a monitored input does not
# click when you change it.
# CONFIG_OSYNTH_ENABLE_MIC_IN=y

# Run the mic's controller as an I2S *slave* off the BCLK and WS the output
# port already drives, instead of mastering a second pair. Default y, and
# worth keeping: one pin instead of three, and the capture is sample-locked to
# playback the same way the line input is. The GPIO matrix allows one output
# driver and any number of input taps on a pad.
#
# The slot width then follows the output port and is not yours to set — 32-bit
# on a build with MCLK (ES8388 or PCM1808 present), 16-bit on a bare PCM5102A.
# Both decode a 24-bit MSB-first MEMS mic; see OSYNTH_MIC_SLOT_BITS.
# CONFIG_OSYNTH_MIC_SHARE_CLOCKS=y

# The mic's data pin (its SD / DOUT). Free on these defaults: 1, 2, 4, 6, 7,
# 21, 38-44, 47, 48. **GPIO33-37 are the octal PSRAM**, GPIO0/3/45/46 are
# strapping pins, GPIO19/20 are the USB PHY, and 8-18 are the codec bus, the
# SD card and the I2S port.
# CONFIG_OSYNTH_MIC_DIN_GPIO=4

# Only when the mic masters its own clocks (SHARE_CLOCKS=n).
# CONFIG_OSYNTH_MIC_BCLK_GPIO=6
# CONFIG_OSYNTH_MIC_WS_GPIO=7
# CONFIG_OSYNTH_MIC_SLOT_BITS=32

# Which half of the frame the mic drives — its L/R strap decides, and reading
# the wrong one is silence from a mic that is working perfectly. An INMP441
# breakout usually ships with L/R floating, which is not a defined state: tie
# it. The chosen slot is duplicated to both channels on the way in, so a mono
# mic folds to itself and a mono looper take does not lose 6 dB.
# CONFIG_OSYNTH_MIC_SLOT_LEFT=y
# CONFIG_OSYNTH_MIC_SLOT_RIGHT=y

# Two mics on one bus strapped opposite ways, or an ES7210-class array: keep
# both slots as a real stereo pair and ignore the choice above.
# CONFIG_OSYNTH_MIC_STEREO=y

# Digital gain in bits, applied where the 24-bit word is truncated to 16, so
# it is free — each bit is +6 dB out of precision the int16 pipeline was going
# to discard. Saturating. A MEMS mic at conversational distance sits well
# below full scale; 2 or 3 is a reasonable start, with `in.gain` on top. Watch
# `in pk` in the heartbeat, which reads after this and before `in.gain`.
# CONFIG_OSYNTH_MIC_SHIFT=0

# --- ES8388 codec (only with OSYNTH_FRONTEND_ES8388) ------------------------

# Control bus. Internal pull-ups are enabled so a bare chip has some chance of
# answering the probe, but they are ~45k and the datasheet asks for 1k. Any
# ready-made codec board already fits its own (2.2k on the M5Stack M144) — do
# not add more in parallel. See private_docs/HARDWARE.md.
CONFIG_OSYNTH_ES8388_I2C_SDA_GPIO=8
CONFIG_OSYNTH_ES8388_I2C_SCL_GPIO=9

# Which analogue input pair the ADC listens to (only with line input on).
# There is no way to detect it and boards differ, so this one has to be set to
# match the board rather than left alone:
#
#   DIFF   the M5Stack Module Audio (M144). Its jack is wired differentially,
#          so each channel is the difference across its pair. A single-ended
#          selection there still gives audio at a sane level with a normal
#          noise floor — but recovers exactly *half* the amplitude on that
#          channel, heard as the image stuck to one side. The tell is a 2:1
#          ratio that never moves with the source material.
#   LINE1  the on-board microphone on an ESP32-A1S or LyraT.
#   LINE2  the line/aux jack on an ESP32-A1S, LyraT and most "audio kit"
#          boards. Was the default here before the M144 was the target board.
#
# Set for the M5Stack Module Audio (M144), wired per private_docs/HARDWARE.md.
# CONFIG_OSYNTH_ES8388_IN_LINE1=y
# CONFIG_OSYNTH_ES8388_IN_LINE2=y
CONFIG_OSYNTH_ES8388_IN_DIFF=y

# M5Stack Module Audio (M144) only: the two switches its STM32 owns, both of
# which sit on the codec's LIN1. Skipped entirely unless something answers at
# I2C 0x33, so no other board is affected. The boot log prints the module's
# registers before and after, which is the way to confirm either of these
# actually took.
#
# LINE_MIC (register 0x00, default y) connects the LINE/MIC jack to LIN1 and
# switches a 3.3k electret bias onto the contact with it. =n takes that bias
# off — worth trying with a line-level source, which does not need it.
# HP_OMTP (register 0x10, default n = CTIA) picks which headset contact reaches
# the shared MIC_MONO_IN node, which also sits on LIN1.
# CONFIG_OSYNTH_ES8388_M5_LINE_MIC=n
CONFIG_OSYNTH_ES8388_M5_HP_OMTP=y

# Channel balance. On the M144 LIN1 is a summing node shared by the LINE/MIC
# jack and the headset mic, each through its own 22k, so it measures a
# consistent 6 dB below RIN1 — heard as the input being "on the right", and not
# a fault. Set both to 0 on a board whose inputs are already matched.
#
# ADC_BALANCE attenuates the louder channel in the codec's per-channel ADC
# digital volume: 0.5 dB steps, cannot clip, costs a little resolution on the
# side turned down. 12 = right down 6 dB. Measure it with a *mono* source and
# read `in pk L/R` from the heartbeat — a ratio of 0.5 is 6 dB, so 12 steps.
CONFIG_OSYNTH_ES8388_ADC_BALANCE=0

# PGA_BALANCE does the same in the analogue PGA by raising the *quieter*
# channel. Costs no resolution, but steps 3 dB at a time and clips
# analogue-side when over-corrected — audibly harsh and metallic on peaks.
# Left at 0; use the ADC balance above unless the input is genuinely too quiet.
CONFIG_OSYNTH_ES8388_PGA_BALANCE=0

# Which output pairs to power. BOTH is the safe answer when the board's wiring
# is unknown, but it is not free: out.level then writes four volume registers
# instead of two, and on a marginal control bus every extra register is another
# chance to land half a stereo update and hear the image jump to one side.
#
# On the M5Stack Module Audio (M144) it is settled. M5's own driver parks
# LOUT2VOL/ROUT2VOL at 0x00 in its init and its setDACVolume() only ever writes
# 0x2e/0x2f, so LOUT1/ROUT1 is what drives the headphone jack and OUT2 goes
# nowhere. OUT1 is that, and halves the runtime writes.
# CONFIG_OSYNTH_ES8388_OUT_BOTH=y
CONFIG_OSYNTH_ES8388_OUT1=y
# CONFIG_OSYNTH_ES8388_OUT2=y

# --- Looper persistence -----------------------------------------------------

# loop.save / loop.load (params 0x0605/0x0606), copying the looper's track set
# between PSRAM and durable storage. Default y (needs PSRAM, hence S3 only).
# Tracks are IMA-ADPCM in both places, so saves and loads are straight copies.
# CONFIG_OSYNTH_LOOP_PERSIST=y

# Storage backend, exactly one member, default FLASH:
#
#   FLASH  raw flash above the partition table, no extra hardware, one slot.
#          Flash writes stall XIP code fetches, so save/load require the
#          transport to be stopped. Sized by the module choice at the top of
#          this file (16 MB module -> 12 MB region, ~260 s stereo ADPCM or
#          double that mono); the region is verified against the detected
#          chip size at boot and trimmed with a warning if it does not fit.
#   SD     SPI-mode FAT card on the pins below: 8 slots, song-scale capacity,
#          and no XIP interference, so save/load work while the loop plays.
#
# CONFIG_OSYNTH_LOOP_STORE_FLASH=y
CONFIG_OSYNTH_LOOP_STORE_SD=y

# --- SD card ----------------------------------------------------------------

# Drum kits from /sd/osynth/kits — .okit images from tools/gen_drumkit.py, or
# folders of .wav one-shots (name a file "03_snare.wav" to pin it to a slot).
# Read into PSRAM. Default n; the factory kit embedded in the firmware works
# without a card.
# CONFIG_OSYNTH_DRUM_SD_KITS=n

# The SD bus is shared: whichever of the SD looper backend and SD drum kits
# gets there first mounts the card, and these pins apply as soon as either is
# on. FSPI IOMUX pins — the fastest SPI this chip has — so prefer to leave
# them alone.
# CONFIG_OSYNTH_SD_CS_GPIO=10
# CONFIG_OSYNTH_SD_MOSI_GPIO=11
# CONFIG_OSYNTH_SD_SCK_GPIO=12
# CONFIG_OSYNTH_SD_MISO_GPIO=13

# --- Serial MIDI ------------------------------------------------------------

# UART RX pin for DIN MIDI, used when OSYNTH_ENABLE_SERIAL_MIDI (see
# sdkconfig.defaults) is on. Default 5 on this target. Rarely wanted here —
# USB-MIDI comes free with the USB-OTG peripheral this chip has.
# CONFIG_OSYNTH_SERIAL_MIDI_RX_GPIO=5

# --- USB host (S35) ---------------------------------------------------------

# Hub support in IDF's USB host library. On, so a hub between osynth and a
# controller works and several controllers can be attached at once — they all
# merge into the MIDI router, which is omni anyway. Costs a little RAM and the
# hub driver's task; harmless in device mode, where the host library is never
# installed at all.
#
# Only reachable when the port is in host mode (`usb.mode` = host, persisted
# and applied at boot). On a build with no I2S DAC the USB sink is the audio
# clock and host mode is refused outright — see SYNTH_USB_IS_AUDIO_CLOCK.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
